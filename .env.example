# Required — Anthropic API key, used by the /api/chat serverless function.
# Never prefix with VITE_, or it will be inlined into the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Upstash Redis credentials for per-IP rate limiting.
# When unset, /api/chat skips the rate-limit check (fine for local review
# or while the URL is private). Create a free database at
# https://console.upstash.com to enable. See the README "Hardening" section.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
