# Anthropic API key — used by the /api/chat serverless function only.
# Never prefix with VITE_, or it will leak into the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Upstash Redis (free tier) — powers per-IP rate limiting in /api/chat.
# Create a database at https://console.upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
